# AI Alert — API 키. 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요.
# .env 는 .gitignore 가 막고 있어 커밋되지 않습니다. 이 예시 파일만 커밋됩니다.

# --- NAVER API HUB (ncloud 콘솔에서 발급. 검색 API + 검색어 트렌드) ---
# 콘솔 > NAVER API HUB > Application > 해당 앱 > API 관리 > [인증 정보]
# 엔드포인트: https://naverapihub.apigw.ntruss.com
# 헤더: X-NCP-APIGW-API-KEY-ID (Client ID) / X-NCP-APIGW-API-KEY (Client Secret)
# 주의: 구버전 openapi.naver.com + X-Naver-Client-Id 방식이 아닙니다.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# --- 카카오 developers (다음 검색 API) ---
# 내 애플리케이션 > 해당 앱 > 앱 설정 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# --- 나중에 채울 것 ---
# ANTHROPIC_API_KEY=          # 요약용 (티켓 05 이후)
# GITHUB_TOKEN=               # Search API 분당 10회 -> 30회로 올리려면 (티켓 10)
